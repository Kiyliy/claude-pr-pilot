# Telegram API credentials (from https://my.telegram.org)
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash

# Phone number for the test account (with country code, e.g. +15551234567)
TG_PHONE=+15551234567

# 2FA password (if enabled)
TG_2FA_PASSWORD=

# TGBotChecker UUID for auto-retrieving verification codes
TGBOTCHECKER_UUID=your_uuid

# The bot username to test against (without @)
BOT_USERNAME=your_bot_username

# Optional: a test group chat ID where the bot is admin
TEST_GROUP_ID=

# Your Telegram user ID (from /info command)
TEST_USER_ID=

# GitHub repo for e2e testing (owner/repo)
TEST_REPO=your-org/your-test-repo

# GitHub App installation ID for the test repo
GITHUB_APP_INSTALLATION_ID=

# Telethon session file name (stored in tests/e2e/)
SESSION_NAME=e2e_test_session

# Optional: override the Claude model used during E2E tests (reduces cost by using a cheaper model)
# Leave unset to use the default model configured in the Claude CLI
CLAUDE_MODEL=claude-haiku-4-5-20251001

# GitHub Personal Access Token (repo scope) for test helpers to create PRs/comments
# Required for: test_sync.py, test_ai_flow.py
GITHUB_TOKEN=
